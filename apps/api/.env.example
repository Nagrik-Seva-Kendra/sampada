# Copy to .env and fill in. NEVER commit .env.
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Admin login (interim — env credentials until a users table lands in the DB phase).
ADMIN_EMAIL=admin@nagrikseva.in
ADMIN_PASSWORD=change-me-strong-password

# Where uploaded guideline PDFs are stored (interim local disk; swap for R2/S3).
# Defaults to apps/api/uploads/guideline if unset.
# UPLOAD_DIR=

# New app database (PostgreSQL — e.g. Neon).
DATABASE_URL="postgresql://sampada:sampada@localhost:5432/sampada?schema=public"
# Direct (unpooled) connection for `prisma migrate` — in prod (Neon) this is
# the non-"-pooler" host; locally, same value as DATABASE_URL.
DIRECT_URL="postgresql://sampada:sampada@localhost:5432/sampada?schema=public"

# Staging copy of the LEGACY MariaDB (read-only reference for migration/testing).
LEGACY_DATABASE_URL="mysql://root:root@localhost:3307/codelogi_sampada"

# Auth (later phase). JWT_SECRET also derives the key used to store a
# recoverable copy of employee/partner passwords for admin lookup.
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
