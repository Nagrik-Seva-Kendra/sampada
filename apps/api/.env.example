# Copy to .env and fill in. NEVER commit .env.
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Public base URL of the web app, used to build password-reset links.
# Defaults to the first CORS_ORIGIN entry, then http://localhost:5173.
# APP_URL=https://sampada-web.vercel.app

# Where uploaded profile photos are stored (local disk; swap for R2/S3 later).
# Defaults to apps/api/uploads/profile-photos if unset.
# UPLOAD_DIR=

# New app database (PostgreSQL — e.g. Neon).
DATABASE_URL="postgresql://sampada:sampada@localhost:5432/sampada?schema=public"
# Direct (unpooled) connection for `prisma migrate` — in prod (Neon) this is
# the non-"-pooler" host; locally, same value as DATABASE_URL.
DIRECT_URL="postgresql://sampada:sampada@localhost:5432/sampada?schema=public"

# Staging copy of the LEGACY MariaDB (read-only reference for migration/testing).
LEGACY_DATABASE_URL="mysql://root:root@localhost:3307/codelogi_sampada"

# Auth.
# JWT_SECRET signs and verifies short-lived access tokens.
# JWT_REFRESH_SECRET signs the long-lived refresh tokens (must be DIFFERENT from
# JWT_SECRET so an access token can never be replayed as a refresh token).
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# Optional token lifetimes (defaults: access 15m, refresh 30d).
# JWT_ACCESS_TTL="15m"
# JWT_REFRESH_TTL="30d"

# SMTP (email OTP verification during partner/employee signup).
SMTP_USER=
SMTP_PASS=
