// Nagrik Seva Kendra — new PostgreSQL schema.
// NOTE: scope is deeds + users only. The guideline/valuation, contact,
// company-docs, deed-register, and partner features were all dropped, along
// with the unused Deed/Buyer/Seller/Partner/AuditLog tables they were
// designed for. DeedTemplate.createdByRole historically contains "PARTNER"
// on legacy-imported rows even though Role no longer has that value — it's a
// free-form string column, not FK'd to the Role enum, so that's harmless.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon's PgBouncer endpoint) for the app at runtime.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection for `prisma migrate` — its advisory locks
  // and DDL don't work reliably through transaction-mode pooling. Locally,
  // where there's no pooler, this is just the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  PUBLIC
  EMPLOYEE
  ADMIN
}

// PENDING: self-signup awaiting admin approval. INACTIVE: admin discontinued
// (reversible). ADMIN accounts are always ACTIVE (created directly, never
// via signup). Doesn't apply to PUBLIC (self-registration isn't wired up yet).
enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// ─── Multi-tenancy (Phase 1) ──────────────────────────────────────────────
// Lifecycle of an organization (customer). Distinct from Subscription.status
// (Phase 3): this gates access to the org itself.
enum OrgStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

// A person's role *within one organization* (lives on Membership, not User).
// Replaces the global User.role for tenant purposes. OWNER is billing/ownership;
// ADMIN manages members + content; EMPLOYEE creates/edits deeds.
enum OrgRole {
  OWNER
  ADMIN
  EMPLOYEE
}

// A membership's state within its org. PENDING = join-request/invite awaiting
// approval; INACTIVE = removed (deactivated, never hard-deleted).
enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum CorrectionStatus {
  PENDING
  RESOLVED
}

// Draft/example deeds shown on a deed-type's public info page (view/print
// only) — matches @sampada/shared's SampleDeedItem exactly. `type` and
// `status` stay plain strings (not enums) because the API validates them via
// zod (DeedType / DeedRecordStatus) before they ever reach Prisma.
// `createdById` is not a User foreign key: legacy-imported rows carry
// synthetic ids ("legacy", "admin") that don't correspond to real users.
model DeedTemplate {
  id             String                  @id
  type           String
  title          String
  content        String                  @db.Text
  status         String                  @default("active")
  createdById    String
  createdByName  String
  createdByRole  String?
  createdAt      DateTime
  updatedAt      DateTime                @updatedAt
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  corrections    DeedCorrectionRequest[]
  propertyDetail DeedPropertyDetail?

  /// Marked by platform staff as a starting point: copied into every new
  /// workspace at onboarding, so a partner's first deed is an edit rather
  /// than a blank page. Must only ever be set on a redacted skeleton — a
  /// real deed carries party names, Aadhaar/PAN and amounts, and this field
  /// hands the row to every organization that signs up from now on.
  isStarter      Boolean                 @default(false)

  @@index([type])
  @@index([createdById])
  @@index([organizationId, type])
  @@index([isStarter])
}

// A correction a party flags via the public share link ("/d/:id"). Scoped to
// the same org as the deed itself (see PublicDeedTenantInterceptor, which
// adopts the deed's org for the whole request) so it goes through the normal
// tenant-scoped Prisma client with no special-casing.
model DeedCorrectionRequest {
  id             String           @id @default(cuid())
  deedTemplateId String
  organizationId String
  message        String           @db.Text
  status         CorrectionStatus @default(PENDING)
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  deedTemplate DeedTemplate @relation(fields: [deedTemplateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  resolvedBy   User?        @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([deedTemplateId, status])
  @@index([organizationId, status])
}

/// Immutable snapshot of a DeedTemplate taken right before each correction
/// that changes its body. This is what makes the party-facing share link
/// (which always resolves to the current DeedTemplate row — see
/// PublicDeedsController) safe to hand out while corrections are ongoing:
/// nothing here is ever mutated after being written, so it doubles as the
/// audit trail of "what changed, when, by whom" for staff. Written by
/// SampleDeedsService.update() / aiDraft() immediately before the row's
/// content changes.
model DeedTemplateRevision {
  id             String       @id @default(cuid())
  deedId         String
  versionNo      Int
  title          String
  content        String       @db.Text
  status         String
  editedById     String?
  editedByName   String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([deedId, versionNo])
  @@index([deedId])
  @@index([organizationId, deedId])
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  /**
   * Login handle the employee sets themselves; null until they do.
   */
  username                 String?                 @unique
  passwordHash             String
  /**
   * Bumped to revoke all existing sessions (access + refresh tokens) for this
   * user — on password change and on deactivation. Tokens carry the version
   * they were minted at; guards reject any token whose version is stale.
   */
  tokenVersion             Int                     @default(0)
  role                     Role                    @default(PUBLIC)
  status                   UserStatus              @default(ACTIVE)
  fname                    String
  lname                    String
  mobile                   String?
  /**
   * Sequential admin-facing id, e.g. "EMP-0007"; only assigned to EMPLOYEE accounts.
   * Legacy mirror of Membership.employeeCode — NOT globally unique: uniqueness
   * is per-org (see Membership.@@unique([organizationId, employeeCode])), so two
   * different orgs can both have an "EMP-0001".
   */
  employeeCode             String?
  /**
   * Stored profile-photo filename (under uploads/profile-photos/); null if none.
   */
  photoFileName            String?
  /**
   * Platform staff (me/my team) — NOT a customer role. Gates the Phase 5
   * back-office. Independent of any Membership.
   */
  isPlatformAdmin          Boolean                 @default(false)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  memberships              Membership[]
  /**
   * Which org this user last acted under — lets login/refresh land back in
   * the same workspace instead of an arbitrary membership. Nulled if that
   * org is ever deleted.
   */
  lastActiveOrganizationId String?
  lastActiveOrganization   Organization?           @relation("UserLastActiveOrganization", fields: [lastActiveOrganizationId], references: [id], onDelete: SetNull)
  resolvedCorrections      DeedCorrectionRequest[]
}

/// An organization (customer tenant). Every tenant-scoped row belongs to one.
/// `nextEmployeeCode` is a per-org counter incremented inside a transaction on
/// member creation — never count()+1, which races and duplicates.
model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  status           OrgStatus @default(TRIALING)
  joinCode         String    @unique
  nextEmployeeCode Int       @default(1)
  /**
   * True for the single-member workspace auto-created at onboarding. Drives
   * UI copy only (e.g. a "Personal" badge) — no access-control difference
   * from a regular org; a personal org can later gain more members like any
   * other.
   */
  isPersonal       Boolean   @default(false)
  /**
   * What the founder told the onboarding wizard they do, and what they came
   * for. Until now the wizard asked and threw the answers away. Kept because
   * it personalises the first-run checklist, and because it is the only thing
   * we know about a partner before they have done anything at all.
   */
  onboardingRole   String?
  onboardingGoal   String?
  /**
   * The district this partner works in, asked at onboarding. Points the
   * first-run checklist straight at their own guideline rates instead of a
   * district picker they have to solve first.
   */
  district         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships         Membership[]
  deeds               DeedTemplate[]
  deedRevisions       DeedTemplateRevision[]
  parties             Party[]
  deedParties         DeedParty[]
  deedNaxas           DeedNaxa[]
  deedPropertyDetails DeedPropertyDetail[]
  guidelineDocuments  GuidelineDocument[]
  usersLastActiveHere User[]                  @relation("UserLastActiveOrganization")
  correctionRequests  DeedCorrectionRequest[]
}

/// A user's place in one organization. Carries the role, status, and per-org
/// employee code that used to live on User (a person may belong to more than
/// one org). employeeCode is unique *within* an org, not globally.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  status         MemberStatus @default(PENDING)
  employeeCode   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
}

/// A person on deeds (buyer/seller). Their Aadhaar card is stored once here,
/// deduplicated by aadhaarNumber, and reused across every deed they're part of
/// so the same card is never uploaded twice. Bytes live in Postgres because the
/// API host has no persistent disk.
model Party {
  id                  String       @id @default(cuid())
  name                String
  partyType           String       @default("individual")
  /**
   * Date of birth as free text (e.g. "01/01/1990" or just a year), typically
   * OCR'd off the Aadhaar card; optional.
   */
  dob                 String?
  address             String?
  aadhaarNumber       String?
  fileName            String?
  mimeType            String?
  size                Int?
  data                Bytes?
  aadhaarBackFileName String?
  aadhaarBackMimeType String?
  aadhaarBackSize     Int?
  aadhaarBackData     Bytes?
  panNumber           String?
  panFileName         String?
  panMimeType         String?
  panSize             Int?
  panData             Bytes?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  deedLinks           DeedParty[]

  @@unique([organizationId, aadhaarNumber])
  @@unique([organizationId, panNumber])
  @@index([organizationId])
}

/// Links a Party to a deed (DeedTemplate) with their role on that deed. `role`
/// is "buyer" | "seller". A party is linked at most once per role per deed.
/// `deedId` is the DeedTemplate id, kept as a plain column (the codebase does
/// not FK to DeedTemplate because of legacy synthetic ids).
model DeedParty {
  id             String       @id @default(cuid())
  deedId         String
  partyId        String
  role           String
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  party          Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([deedId, partyId, role])
  @@index([deedId])
  @@index([partyId])
  @@index([organizationId, deedId])
}

/// The property map ("naxa") for a deed. Per-deed (not shared); multiple pages
/// allowed. Bytes stored in Postgres for the same persistence reason.
model DeedNaxa {
  id             String       @id @default(cuid())
  deedId         String
  fileName       String
  mimeType       String
  size           Int
  data           Bytes
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([deedId])
  @@index([organizationId, deedId])
}

/// Structured property data for a deed (plot no., E-W/N-S measurements,
/// chauhaddi) — the single source of truth that both the deed text and the
/// auto-generated naksha (site plan) drawing render from, so the two can
/// never disagree. `location` is one free-text address block (colony,
/// village, patwari halka, district, etc. together — deeds phrase this too
/// differently to split into fixed fields without cost). `sellerName`/
/// `buyerName` are read from the deed's own text, not the separate
/// Party/DeedParty records. At most one row per deed. `source` distinguishes
/// staff-entered data from Phase-5 regex-extracted data pending verification
/// (never trusted until `verifiedAt`/`verifiedBy` are set). Only
/// rectangle/square plots are supported today (`shape`). Soft-deleted via
/// `deletedAt` — the first model in this codebase to use that pattern (see
/// tenant-scope.core.ts's MODELS_WITH_SOFT_DELETE) rather than Organization's
/// status-flip style, since a per-row (not per-tenant) delete needs a
/// timestamp, not an enum.
model DeedPropertyDetail {
  id             String       @id @default(cuid())
  deedId         String       @unique
  deed           DeedTemplate @relation(fields: [deedId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  plotNo         String?
  block          String?
  location       String
  sellerName     String?
  buyerName      String?
  shape          String       @default("rectangle")
  ewLength       Decimal
  nsLength       Decimal
  unit           String
  statedArea     Decimal?
  statedAreaUnit String?
  boundaryNorth  String
  boundarySouth  String
  boundaryEast   String
  boundaryWest   String

  /// "manual" (staff-entered via the deed form) | "extracted" (Phase 5
  /// backfill, only ever written once a human approves it).
  source     String    @default("manual")
  verifiedAt DateTime?
  verifiedBy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, plotNo])
  @@index([deedId])
}

/// Guideline documents (official circulars/rate PDFs) uploaded by admins via
/// the Manage Guideline admin page. Visible and downloadable by everyone —
/// list/download endpoints are public, only upload/delete require admin auth.
/// Bytes stored in Postgres for the same persistence reason as Party/DeedNaxa.
model GuidelineDocument {
  id             String       @id @default(cuid())
  title          String
  district       String
  session        Int
  /// Which language this specific PDF is in — English and Hindi are stored
  /// as separate rows (same district+session, different language), not one
  /// row with two files.
  language       Language     @default(en)
  fileName       String
  mimeType       String
  size           Int
  data           Bytes
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([district, session])
  @@index([district, session, language])
  @@index([organizationId, district, session])
}

enum Language {
  en
  hi
}

/// Single-use, 1-hour password-reset tokens minted by an admin ("send reset
/// link") for a user. Only the SHA-256 hash of the raw token is stored; the raw
/// value lives only in the emailed / handed-out link. Consuming a token sets
/// usedAt so it can never be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use, 7-day email invites minted by an org admin/owner to bring
/// someone in with a chosen role (never OWNER — that's ownership transfer's
/// job). Only the SHA-256 hash of the raw token is stored. usedAt marks
/// acceptance; revokedAt marks an admin cancelling it early — both block reuse.
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, email])
}

/// Owner-initiated, single-use, 7-day ownership-transfer confirmation link.
/// The owner's authenticated request to create this IS their confirmation;
/// the nominee confirms by visiting the link. confirmedAt marks acceptance;
/// cancelledAt marks the owner cancelling it early — both block reuse.
model OwnershipTransfer {
  id             String    @id @default(cuid())
  organizationId String
  fromUserId     String
  toUserId       String
  tokenHash      String    @unique
  expiresAt      DateTime
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
}

enum PropertyCategory {
  PLOT
  VILLA
  FLAT
  AGRICULTURAL_LAND
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A property listing for the public sales website (plots/villas/flats/
/// agricultural land). Shared across the whole business, not tenant-scoped —
/// same precedent as GuidelineDocument. Public read (published only) + staff
/// write, managed from the internal "Property upload" app.
model Property {
  id            String           @id @default(cuid())
  title         String
  category      PropertyCategory
  description   String?
  addressLine   String
  city          String
  district      String?
  state         String           @default("Madhya Pradesh")
  pincode       String?
  areaValue     Float?
  areaUnit      String?
  priceValue    Float?
  priceLabel    String?
  status        PropertyStatus   @default(DRAFT)
  contactName   String?
  contactPhone  String?
  createdById   String?
  createdByName String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  images        PropertyImage[]

  @@index([category, status])
  @@index([city, status])
}

/// One image for a Property, ordered by sortOrder. data/r2Key mirror the
/// dual-path pattern in GuidelineDocument/r2.ts: prefer R2 when configured,
/// fall back to storing bytes in Postgres otherwise.
model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  data       Bytes?
  r2Key      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId, sortOrder])
}
