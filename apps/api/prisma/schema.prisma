// Nagrik Seva Kendra — new PostgreSQL schema.
// NOTE: scope is deeds + users only. The guideline/valuation, contact,
// company-docs, deed-register, and partner features were all dropped, along
// with the unused Deed/Buyer/Seller/Partner/AuditLog tables they were
// designed for. DeedTemplate.createdByRole historically contains "PARTNER"
// on legacy-imported rows even though Role no longer has that value — it's a
// free-form string column, not FK'd to the Role enum, so that's harmless.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (e.g. Neon's PgBouncer endpoint) for the app at runtime.
  url = env("DATABASE_URL")
  // Direct (unpooled) connection for `prisma migrate` — its advisory locks
  // and DDL don't work reliably through transaction-mode pooling. Locally,
  // where there's no pooler, this is just the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  PUBLIC
  EMPLOYEE
  ADMIN
}

// PENDING: self-signup awaiting admin approval. INACTIVE: admin discontinued
// (reversible). ADMIN accounts are always ACTIVE (created directly, never
// via signup). Doesn't apply to PUBLIC (self-registration isn't wired up yet).
enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// Draft/example deeds shown on a deed-type's public info page (view/print
// only) — matches @sampada/shared's SampleDeedItem exactly. `type` and
// `status` stay plain strings (not enums) because the API validates them via
// zod (DeedType / DeedRecordStatus) before they ever reach Prisma.
// `createdById` is not a User foreign key: legacy-imported rows carry
// synthetic ids ("legacy", "admin") that don't correspond to real users.
model DeedTemplate {
  id String @id
  type String
  title String
  content String @db.Text
  status String @default("active")
  createdById String
  createdByName String
  createdByRole String?
  createdAt DateTime
  updatedAt DateTime @updatedAt
  

  @@index([type])
  @@index([createdById])
}

/// Immutable snapshot of a DeedTemplate taken right before each correction
/// that changes its body. This is what makes the party-facing share link
/// (which always resolves to the current DeedTemplate row — see
/// PublicDeedsController) safe to hand out while corrections are ongoing:
/// nothing here is ever mutated after being written, so it doubles as the
/// audit trail of "what changed, when, by whom" for staff. Written by
/// SampleDeedsService.update() / aiDraft() immediately before the row's
/// content changes.
model DeedTemplateRevision {
  id String @id @default(cuid())
  deedId String
  versionNo Int
  title String
  content String @db.Text
  status String
  editedById String?
  editedByName String?
  createdAt DateTime @default(now())

  @@unique([deedId, versionNo])
  @@index([deedId])
}

model User {
  id String @id @default(cuid())
  email String @unique
  /**
   * Login handle the employee sets themselves; null until they do.
   */
  username String? @unique
  passwordHash String
  /**
   * AES-256-GCM reversible copy so the admin can look up what the user set: `<iv-hex>:<tag-hex>:<ciphertext-hex>`.
   */
  passwordEnc String?
  role Role @default(PUBLIC)
  status UserStatus @default(ACTIVE)
  fname String
  lname String
  mobile String?
  /**
   * Sequential admin-facing id, e.g. "EMP-0007"; only assigned to EMPLOYEE accounts.
   */
  employeeCode String? @unique
  /**
   * Stored profile-photo filename (under uploads/profile-photos/); null if none.
   */
  photoFileName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A person on deeds (buyer/seller). Their Aadhaar card is stored once here,
/// deduplicated by aadhaarNumber, and reused across every deed they're part of
/// so the same card is never uploaded twice. Bytes live in Postgres because the
/// API host has no persistent disk.
model Party {
  id String @id @default(cuid())
  name String
  partyType String @default("individual")
  /**
   * Date of birth as free text (e.g. "01/01/1990" or just a year), typically
   * OCR'd off the Aadhaar card; optional.
   */
  dob String?
  address String?
  aadhaarNumber String? @unique
  fileName String?
  mimeType String?
  size Int?
  data Bytes?
  aadhaarBackFileName String?
  aadhaarBackMimeType String?
  aadhaarBackSize Int?
  aadhaarBackData Bytes?
  panNumber String? @unique
  panFileName String?
  panMimeType String?
  panSize Int?
  panData Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deedLinks DeedParty[]
}

/// Links a Party to a deed (DeedTemplate) with their role on that deed. `role`
/// is "buyer" | "seller". A party is linked at most once per role per deed.
/// `deedId` is the DeedTemplate id, kept as a plain column (the codebase does
/// not FK to DeedTemplate because of legacy synthetic ids).
model DeedParty {
  id String @id @default(cuid())
  deedId String
  partyId String
  role String
  createdAt DateTime @default(now())
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([deedId, partyId, role])
  @@index([deedId])
  @@index([partyId])
}

/// The property map ("naxa") for a deed. Per-deed (not shared); multiple pages
/// allowed. Bytes stored in Postgres for the same persistence reason.
model DeedNaxa {
  id String @id @default(cuid())
  deedId String
  fileName String
  mimeType String
  size Int
  data Bytes
  createdAt DateTime @default(now())

  @@index([deedId])
}

/// Guideline documents (official circulars/rate PDFs) uploaded by admins via
/// the Manage Guideline admin page. Visible and downloadable by everyone —
/// list/download endpoints are public, only upload/delete require admin auth.
/// Bytes stored in Postgres for the same persistence reason as Party/DeedNaxa.
model GuidelineDocument {
  id String @id @default(cuid())
  title String
  district String
  session Int
  fileName String
  mimeType String
  size Int
  data Bytes
  uploadedById String?
  uploadedByName String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([district, session])
}
