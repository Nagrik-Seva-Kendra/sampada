# Copy to .env and fill in. NEVER commit .env.

# Base URL of the API. Leave unset for local dev (Vite proxies /api to
# localhost:3001, see vite.config.ts) and for any setup where web+api share
# an origin. Set to the api Vercel project's URL when web and api are
# deployed as separate Vercel projects.
# VITE_API_URL=https://your-api-project.vercel.app
